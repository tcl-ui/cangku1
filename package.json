{
  "name": "chenguang-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "辰光Agent平台 — Vue3 前端框架（TypeScript + Pinia + Vue Router）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.1.10"
  }
}
